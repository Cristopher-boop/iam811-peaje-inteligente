# ==============================================================================
# Sistema Inteligente de Control de Peaje (IAM-811) - Plantilla de Variables
# Copia este archivo como .env y completa los valores reales en tu nube.
# NUNCA subas el archivo .env al repositorio Git.
# ==============================================================================

# --- Entorno Web / API ---
APP_ENV=production
APP_BASE_URL=https://tu-subdominio.onrender.com
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-larga-de-64-caracteres
SESSION_SECRET=cambia-esto-por-otra-clave-aleatoria-para-cookies
TIMEZONE_OFFSET=-4

# --- Base de datos en la nube (PostgreSQL: Neon / Supabase / Railway) ---
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/peaje_db?sslmode=require

# --- Endpoint de Inferencia en la nube (RunPod o Colab) ---
# Ejemplo RunPod: https://<POD_ID>-8000.proxy.runpod.net
INFERENCE_URL=https://tu-pod-id-8000.proxy.runpod.net
INFERENCE_API_TOKEN=cambia-esto-por-el-mismo-token-de-runpod
INFERENCE_TIMEOUT_SECONDS=20

# --- Google OAuth 2.0 (Web y App Movil) ---
GOOGLE_CLIENT_ID=tu-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-web-client-secret
GOOGLE_ANDROID_CLIENT_ID=tu-android-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://tu-subdominio.onrender.com/auth/google/callback

# --- Lista blanca inicial de administradores (separados por coma) ---
ADMIN_EMAILS=doc.alvaro.pinto.ma@unifranz.edu.bo,cristopherrodriguez1510@gmail.com

# --- Agente Conversacional (Qwen via API Web compatible con OpenAI) ---
# Ejemplo OpenRouter: https://openrouter.ai/api/v1 y modelo qwen/qwen-2.5-72b-instruct
# Ejemplo DashScope:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1 y modelo qwen-plus
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_API_KEY=sk-or-v1-reemplazar
QWEN_MODEL=google/gemma-4-31b-it:free

# --- Configuracion interna del servidor de inferencia (/inferencia) ---
API_TOKEN=cambia-esto-por-el-mismo-token-de-runpod
M2_WEIGHTS=models/best_m2_seg.pt
M3_WEIGHTS=models/best_m3_pose.pt
M1_CONF=0.35
M2_CONF=0.30
M3_CONF=0.25
PORT=8000
